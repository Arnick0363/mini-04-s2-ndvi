{
  "source": "Element84 Earth Search 公开 COG，集合 sentinel-2-c1-l2a（Copernicus Sentinel-2 L2A Collection-1）",
  "credit": "Contains modified Copernicus Sentinel data 2026",
  "stac_endpoint": "https://earth-search.aws.element84.com/v1",
  "why_these_dates": "2026-01-08 与 2026-08-06 同为 Sentinel-2C、分幅 49QGE。一月代表冬季旱季，八月代表夏季湿季。珠江口夏季整景云量很少低于 10%，因此先保留研究区内 SCL 晴空比例高的八月景，而不是只看 110 km 分幅的整景云量。",
  "resolution_note": "输出格网 10 m，与 B04/B08 的原生分辨率一致。整块读取约 1.5 MB 的压缩瓦片时，HTTP 响应会被截断，因此按不超过 1 MB 的 Range 分段下载后再解码。SCL 本身是 20 m，用最近邻采样对齐到 10 m 格网，云掩膜的边缘仍按 20 m 台阶变化。NDVI 用的是 B04 与 B08 的地表反射率。",
  "aoi_file": "data/raw/aoi.geojson",
  "target_grid": {
    "crs": "EPSG:32649",
    "resolution_m": 10.0,
    "width": 904,
    "height": 1403,
    "pad_m": 800.0
  },
  "reflectance_note": "地表反射率 = DN * scale + offset。本批 COG 的 scale=0.0001、offset=-0.1，等价于 (DN-1000)/10000。NDVI 对共同乘数不敏感，但对这个加性偏移敏感，所以必须换算后再做比值。",
  "scl_clear_classes": [
    2,
    4,
    5,
    6,
    7
  ],
  "scl_class_meaning": {
    "0": "无数据",
    "1": "饱和或缺陷",
    "2": "暗像元（保留）",
    "3": "云影",
    "4": "植被",
    "5": "非植被",
    "6": "水体",
    "7": "未分类（保留）",
    "8": "中概率云",
    "9": "高概率云",
    "10": "薄卷云",
    "11": "雪或冰"
  },
